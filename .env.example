# -----------------------------------------------------------------------------
# OmniFlow SaaS Platform Environment Configuration
# -----------------------------------------------------------------------------

# Environment Mode
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"

# Database Configuration (SQLite local profile)
DATABASE_URL="file:./dev.db"

# Supabase PostgreSQL. When set, it overrides SQLite at runtime.
# Use the Transaction pooler URL (port 6543) for the application and the
# direct/session URL (port 5432) for Prisma schema operations.
SUPABASE_DATABASE_URL=""
SUPABASE_DIRECT_URL=""

# Production/isolated-test PostgreSQL URLs. Never point tests at production data.
POSTGRES_DATABASE_URL=""
POSTGRES_TEST_DATABASE_URL=""

# JWT Auth Secret Key (required; generate a unique random 32+ character value)
JWT_SECRET=""

# Platform Super Admin Seed Credentials
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Optional isolated demo seed. It never sends through real providers.
SEED_DEMO=false
DEMO_USER_EMAIL="demo@localhost.invalid"
DEMO_USER_PASSWORD=""

# Meta Developer App Credentials (WhatsApp Cloud API, Instagram DM, Facebook Messenger)
META_GRAPH_API_VERSION="v23.0"
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/meta/callback"
META_WHATSAPP_CONFIG_ID=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
META_WEBHOOK_VERIFY_TOKEN=""

# Google Developer OAuth Credentials (Gmail API)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Azure App Credentials (Outlook Graph API)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# AI Provider API Configuration (OpenAI / BYOK Ready)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# SMTP Email Dispatcher (For Auth & Password Reset System Notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@omniflow.app"

# File Storage Provider (local | s3 | supabase)
STORAGE_PROVIDER="local"

# Durable background job processor / Vercel Cron bearer secret
CRON_SECRET=""

# Optional bearer secret for detailed /api/health metrics
HEALTH_SECRET=""

# 32-byte base64 key used to encrypt stored provider credentials
INTEGRATION_ENCRYPTION_KEY=""

# Evolution API (WhatsApp QR connection)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_WEBHOOK_SECRET=""
