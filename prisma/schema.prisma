datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Core Auth & Multi-Tenancy
// -----------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  isSuperAdmin  Boolean  @default(false)
  status        String   @default("ACTIVE") // ACTIVE, SUSPENDED
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships             WorkspaceMember[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  assignedTasks           Task[]
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  businessType    String   @default("PHYSICAL") // PHYSICAL, DIGITAL, SERVICE, SUBSCRIPTION, COURSE, BOOKING
  country         String   @default("SA")
  currency        String   @default("SAR")
  timezone        String   @default("Asia/Riyadh")
  taxRate         Float    @default(15.0)
  taxNumber       String?
  businessAddress String?
  status          String   @default("ACTIVE") // ACTIVE, READ_ONLY, SUSPENDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members              WorkspaceMember[]
  subscriptions        Subscription[]
  contacts             Contact[]
  products             Product[]
  pipelines            Pipeline[]
  orders               Order[]
  payments             Payment[]
  invoices             Invoice[]
  expenses             Expense[]
  channels             Channel[]
  conversations        Conversation[]
  campaigns            Campaign[]
  automations          Automation[]
  aiAgent              AiAgent?
  tasks                Task[]
  auditLogs            AuditLog[]
  invitations          WorkspaceInvitation[]
  webhookEvents        WebhookEvent[]
  backgroundJobs       BackgroundJob[]
  deadLetterEvents     DeadLetterEvent[]
  automationRuns       AutomationRun[]
  aiUsageLogs          AiUsageLog[]
  suppressionEntries   SuppressionEntry[]
  subscriptionPayments SubscriptionPayment[]
}

model WorkspaceMember {
  id                String    @id @default(uuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              String    @default("ADMIN") // OWNER, ADMIN, SALES, SUPPORT, ACCOUNTANT, VIEWER
  customPermissions String?
  status            String    @default("ACTIVE") // INVITED, ACTIVE, SUSPENDED
  invitedAt         DateTime  @default(now())
  joinedAt          DateTime?

  @@unique([workspaceId, userId])
  @@index([userId, status])
  @@index([workspaceId, status])
}

model WorkspaceInvitation {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email           String
  role            String    @default("VIEWER")
  tokenHash       String    @unique
  invitedByUserId String
  status          String    @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([workspaceId, status])
  @@index([email, status])
}

// -----------------------------------------------------------------------------
// Billing & Subscriptions
// -----------------------------------------------------------------------------

model Plan {
  id           String   @id @default(uuid())
  name         String
  nameAr       String
  description  String
  isActive     Boolean  @default(true)
  sortingOrder Int      @default(0)
  createdAt    DateTime @default(now())

  prices               PlanPrice[]
  entitlements         PlanEntitlements?
  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
}

model PlanPrice {
  id       String @id @default(uuid())
  planId   String
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  interval String // MONTHLY, YEARLY
  price    Float
  currency String @default("SAR")
}

model PlanEntitlements {
  id               String  @id @default(uuid())
  planId           String  @unique
  plan             Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  maxUsers         Int     @default(3)
  maxContacts      Int     @default(1000)
  maxMessages      Int     @default(5000)
  maxCampaigns     Int     @default(10)
  aiTokensLimit    Int     @default(50000)
  enableWhitelabel Boolean @default(false)
}

model Subscription {
  id                 String    @id @default(uuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  status             String    @default("TRIALING") // TRIALING, ACTIVE, PAST_DUE, CANCELED
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  createdAt          DateTime  @default(now())
}

model SubscriptionPayment {
  id                String    @id @default(uuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan      @relation(fields: [planId], references: [id])
  submittedByUserId String
  reviewedByUserId  String?
  amount            Float
  currency          String    @default("SAR")
  interval          String    @default("MONTHLY")
  referenceNumber   String?
  proofUrl          String?
  note              String?
  reviewNote        String?
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED
  submittedAt       DateTime  @default(now())
  reviewedAt        DateTime?

  @@index([workspaceId, status, submittedAt])
  @@index([status, submittedAt])
}

// -----------------------------------------------------------------------------
// CRM & Contacts
// -----------------------------------------------------------------------------

model Contact {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fullName       String
  avatarUrl      String?
  phone          String?
  email          String?
  stage          String    @default("LEAD") // LEAD, CONTACTED, CUSTOMER, VIP, INACTIVE
  assignedUserId String?
  source         String    @default("DIRECT") // DIRECT, WHATSAPP, INSTAGRAM, FACEBOOK, EMAIL, WEBSITE
  totalSpent     Float     @default(0.0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  channels      ContactChannel[]
  tags          ContactTag[]
  orders        Order[]
  conversations Conversation[]
  tasks         Task[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, stage])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
}

model ContactChannel {
  id          String  @id @default(uuid())
  contactId   String
  contact     Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  provider    String // WHATSAPP, INSTAGRAM, FACEBOOK, EMAIL
  handleId    String
  optInStatus Boolean @default(true)
}

model Tag {
  id          String @id @default(uuid())
  workspaceId String
  name        String
  color       String @default("#0284c7")

  contacts ContactTag[]
}

model ContactTag {
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
}

// -----------------------------------------------------------------------------
// Omnichannel Messaging
// -----------------------------------------------------------------------------

model Channel {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider     String // WHATSAPP, INSTAGRAM, FACEBOOK, EMAIL, DEV_MOCK
  name         String
  isActive     Boolean   @default(true)
  healthStatus String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  settingsJson String? // Config & API Keys encrypted JSON
  createdAt    DateTime  @default(now())

  conversations Conversation[]

  @@index([workspaceId, provider])
  @@index([workspaceId, healthStatus])
}

model Conversation {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelId      String
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status         String    @default("OPEN") // OPEN, PENDING, CLOSED
  unreadCount    Int       @default(0)
  aiEnabled      Boolean   @default(true)
  assignedUserId String?
  lastMessageAt  DateTime  @default(now())
  createdAt      DateTime  @default(now())

  messages Message[]

  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assignedUserId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType     String // USER, CONTACT, AI, AUTOMATION
  senderId       String?
  channel        String // WHATSAPP, INSTAGRAM, FACEBOOK, EMAIL, DEV_MOCK
  body           String
  mediaUrl       String?
  rawPayload     String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model SavedReply {
  id          String  @id @default(uuid())
  workspaceId String
  title       String
  content     String
  shortcut    String?
}

// -----------------------------------------------------------------------------
// Products & Pipeline Orders
// -----------------------------------------------------------------------------

model Product {
  id            String    @id @default(uuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title         String
  sku           String?
  type          String    @default("PHYSICAL") // PHYSICAL, DIGITAL, SERVICE, SUBSCRIPTION, COURSE, BOOKING
  price         Float
  costPrice     Float     @default(0.0)
  currency      String    @default("SAR")
  stockQuantity Int       @default(100)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  orderItems OrderItem[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, createdAt])
}

model Pipeline {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String    @default("مسار المبيعات الرئيسي")
  isDefault   Boolean   @default(true)

  stages PipelineStage[]
}

model PipelineStage {
  id           String   @id @default(uuid())
  pipelineId   String
  pipeline     Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name         String
  color        String   @default("#3b82f6")
  sortingOrder Int      @default(0)

  orders Order[]
}

model Order {
  id           String        @id @default(uuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stageId      String
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  totalAmount  Float
  paidAmount   Float         @default(0.0)
  status       String        @default("PENDING") // PENDING, PAID, IN_PROGRESS, COMPLETED, CANCELED
  deliveryDate DateTime?
  channel      String        @default("INBOX")
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, contactId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  quantity  Int      @default(1)
  price     Float
  total     Float
}

model Payment {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  amount      Float
  method      String    @default("BANK_TRANSFER") // BANK_TRANSFER, CASH, CARD, ONLINE
  status      String    @default("CONFIRMED") // PENDING, CONFIRMED, REJECTED, REFUNDED
  proofUrl    String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, status, createdAt])
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  totalAmount   Float
  status        String    @default("ISSUED") // ISSUED, PAID, CANCELED
  issueDate     DateTime  @default(now())
  pdfPath       String?

  @@unique([workspaceId, invoiceNumber])
}

model Expense {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    String    @default("تشغيلي")
  amount      Float
  currency    String    @default("SAR")
  expenseDate DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, expenseDate])
}

// -----------------------------------------------------------------------------
// Campaigns & Automations
// -----------------------------------------------------------------------------

model Campaign {
  id              String    @id @default(uuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel         String // EMAIL, WHATSAPP
  title           String
  targetSegment   String    @default("ALL")
  templateContent String
  status          String    @default("DRAFT") // DRAFT, SCHEDULED, RUNNING, COMPLETED, FAILED
  scheduledAt     DateTime?
  sentCount       Int       @default(0)
  deliveredCount  Int       @default(0)
  failedCount     Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([workspaceId, status, scheduledAt])
}

model Automation {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title        String
  triggerEvent String // NEW_MESSAGE, CONTACT_CREATED, ORDER_STATUS_CHANGED, PAYMENT_CONFIRMED
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  steps AutomationStep[]
  runs  AutomationRun[]

  @@index([workspaceId, isActive])
}

model AutomationStep {
  id           String     @id @default(uuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  stepType     String // SEND_MESSAGE, SEND_EMAIL, ADD_TAG, ASSIGN_USER, AI_REPLY
  stepConfig   String // JSON config
  sortingOrder Int        @default(0)
}

// -----------------------------------------------------------------------------
// AI Assistant & Knowledge Base
// -----------------------------------------------------------------------------

model AiAgent {
  id                  String    @id @default(uuid())
  workspaceId         String    @unique
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name                String    @default("مساعد العمليات الذكي")
  role                String    @default("ممثل خدمة العملاء والمبيعات")
  tone                String    @default("مهني وودود")
  businessInfo        String?
  confidenceThreshold Float     @default(0.75)
  mode                String    @default("SUGGEST") // OFF, SUGGEST, AUTO_REPLY
  isEnabled           Boolean   @default(true)

  chunks    AiKnowledgeChunk[]
  usageLogs AiUsageLog[]
}

model AiKnowledgeChunk {
  id        String  @id @default(uuid())
  agentId   String
  agent     AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title     String
  content   String
  sourceUrl String?
}

// -----------------------------------------------------------------------------
// Tasks & System Support
// -----------------------------------------------------------------------------

model Task {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedUserId String?
  assignedUser   User?     @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  title          String
  dueDate        DateTime?
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  isCompleted    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([workspaceId, isCompleted, dueDate])
}

// -----------------------------------------------------------------------------
// Platform Whitelabel & Admin CMS
// -----------------------------------------------------------------------------

model PlatformSettings {
  id               String   @id @default("default")
  platformName     String   @default("OmniFlow")
  logoUrl          String   @default("/assets/logo.svg")
  faviconUrl       String   @default("/favicon.ico")
  primaryColor     String   @default("#0284c7")
  accentColor      String   @default("#10b981")
  fontArabic       String   @default("Tajawal")
  landingHeroTitle String   @default("كل نشاطك الأونلاين في مكان واحد")
  landingHeroSub   String   @default("منصة عربية شاملة لإدارة العملاء والمحادثات والطلبات والمدفوعات بالأتمتة والذكاء الاصطناعي")
  contactEmail     String   @default("support@omniflow.app")
  supportPhone     String   @default("+966500000000")
  defaultCurrency  String   @default("SAR")
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model PlatformEmailConfig {
  id              String    @id @default("default")
  encryptedConfig String
  hostLabel       String
  fromEmail       String
  status          String    @default("NOT_TESTED") // NOT_TESTED, CONNECTED, ERROR
  lastTestedAt    DateTime?
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

model PlatformAiModel {
  id              String    @id @default(uuid())
  displayName     String
  provider        String    @default("OPENAI_COMPATIBLE")
  baseUrl         String    @default("https://api.openai.com/v1")
  modelId         String
  encryptedConfig String
  isActive        Boolean   @default(true)
  isDefault       Boolean   @default(false)
  status          String    @default("NOT_TESTED") // NOT_TESTED, CONNECTED, ERROR
  lastTestedAt    DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive, isDefault])
}

model Faq {
  id           String  @id @default(uuid())
  question     String
  answer       String
  category     String  @default("عام")
  sortingOrder Int     @default(0)
  isPublished  Boolean @default(true)
}

model SupportTicket {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  subject     String
  category    String   @default("TECHNICAL")
  priority    String   @default("NORMAL")
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages SupportMessage[]

  @@index([status, priority, updatedAt])
}

model SupportMessage {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUserId String
  body         String
  isInternal   Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([ticketId, createdAt])
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  body        String
  audience    String    @default("ALL") // ALL, ACTIVE, TRIALING
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String
  action      String
  targetType  String
  targetId    String?
  metadata    String? // JSON payload
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
}

// -----------------------------------------------------------------------------
// Durable jobs, webhook ingestion, automation runs, AI usage and suppression
// -----------------------------------------------------------------------------

model WebhookEvent {
  id             String    @id @default(uuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId      String
  provider       String
  idempotencyKey String    @unique
  payload        String
  status         String    @default("PENDING")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  lastError      String?

  @@index([workspaceId, status, receivedAt])
}

model BackgroundJob {
  id             String     @id @default(uuid())
  workspaceId    String?
  workspace      Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type           String
  payload        String
  status         String     @default("PENDING")
  idempotencyKey String?    @unique
  attempts       Int        @default(0)
  maxAttempts    Int        @default(5)
  runAt          DateTime   @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  lastError      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, runAt])
  @@index([workspaceId, type, status])
}

model DeadLetterEvent {
  id          String     @id @default(uuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobId       String
  type        String
  payload     String
  attempts    Int
  lastError   String
  failedAt    DateTime   @default(now())

  @@index([workspaceId, failedAt])
}

model AutomationRun {
  id           String               @id @default(uuid())
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automationId String
  automation   Automation           @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggerEvent String
  triggerData  String
  status       String               @default("RUNNING")
  startedAt    DateTime             @default(now())
  completedAt  DateTime?
  lastError    String?
  events       AutomationRunEvent[]

  @@index([workspaceId, status, startedAt])
}

model AutomationRunEvent {
  id        String        @id @default(uuid())
  runId     String
  run       AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepId    String?
  status    String
  message   String?
  output    String?
  createdAt DateTime      @default(now())

  @@index([runId, createdAt])
}

model AiUsageLog {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        AiAgent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  operation    String
  model        String
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  costMicros   Int       @default(0)
  isFallback   Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model SuppressionEntry {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     String
  address     String
  reason      String    @default("OPT_OUT")
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, channel, address])
  @@index([workspaceId, channel])
}
