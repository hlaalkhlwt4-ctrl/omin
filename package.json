{
  "name": "omniflow-saas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/e2e-smoke.mjs",
    "prisma:generate": "node scripts/generate-prisma-clients.mjs",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:supabase": "node scripts/generate-postgres-schema.mjs && prisma generate --schema=prisma/postgresql/schema.prisma",
    "prisma:db:push": "prisma db push",
    "supabase:setup": "node scripts/setup-supabase.mjs",
    "supabase:secure": "node scripts/secure-supabase.mjs",
    "supabase:test": "node scripts/test-supabase-connection.mjs",
    "postgres:schema": "node scripts/generate-postgres-schema.mjs",
    "postgres:rls": "node scripts/apply-postgres-rls.mjs",
    "postgres:test-rls": "node scripts/test-postgres-rls.mjs",
    "pdf:sample": "tsx scripts/render-sample-invoice.ts",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^3.3.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.13.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "framer-motion": "^11.18.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.51.4",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.26",
    "prisma": "^5.13.0",
    "tailwindcss": "^3.4.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
